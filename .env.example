# ============================================================
# DarkMind Auto — Environment Variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# --- General ---
TIMEZONE=America/New_York
RUN_TIMES=07:30,12:30,19:30
HEALTH_PORT=8080
DB_PATH=darkmind.db

# --- LLM (choose one provider) ---
# Set LLM_PROVIDER to "openai" or "anthropic"
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Voiceover ---
# Set TTS_PROVIDER to "elevenlabs" (preferred) or "openai"
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_TTS_VOICE=onyx

# --- Stock footage ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- YouTube ---
# Place client_secret.json next to main.py (OAuth desktop app credentials).
# token.json will be auto-generated on first auth.
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# --- X (Twitter) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# --- Instagram (Graph API) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- TikTok (Content Posting API) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# --- Cloud hosting for public video URL (used by Instagram) ---
# Choose: "s3" or "gdrive"
CLOUD_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
GDRIVE_CREDENTIALS_FILE=gdrive_service_account.json
GDRIVE_FOLDER_ID=
